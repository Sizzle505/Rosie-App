{
  "name": "rosie-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/restore-large-media.mjs && npm run test:ai && npm run test:yacht && npm run test:cosmic && npm run test:nav && npm run test:recipes && npm run test:gamepad && npm run test:tesla && node scripts/generate-rosieverse-icons.mjs && node scripts/build-santa-email-previews.mjs && node scripts/install-tunnel-cinematic.mjs && vite build",
    "preview": "vite preview",
    "icons:generate": "node scripts/generate-rosieverse-icons.mjs",
    "test:ai": "node --test tests/rosie-ai.test.mjs",
    "test:yacht": "node --test tests/yacht-dash.test.mjs tests/yacht-kuroi-finale.test.mjs tests/yacht-kuroi-arena.test.mjs tests/yacht-kuroi-arena-touch-input.test.mjs",
    "test:nav": "node --test tests/royal-navigation.test.mjs",
    "test:recipes": "node --test tests/recipes-methods.test.mjs",
    "test:gamepad": "node --test tests/captain-gamepad.test.mjs",
    "test:tesla": "node --test tests/tesla-mode.test.mjs",
    "test:cosmic": "node --test tests/cosmic-maze-layout.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "vite": "^7.1.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "qrcode-generator": "^1.4.4",
    "cmu-pronouncing-dictionary": "^3.0.0"
  },
  "devDependencies": {}
}
